{
  "appId": "com.reallifetrack.app",
  "appName": "Real Life Track",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#FF5722",
      "sound": "beep.wav"
    },
    "Motion": {
      "frequency": 100
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "useLegacyBridge": false
  }
}
